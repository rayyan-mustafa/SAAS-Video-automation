# ==============================================================================
# TILLERCAST SAAS — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env and configure your environment variables.
# The application functions in offline/fallback mode even with optional keys empty.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & SERVER
# ------------------------------------------------------------------------------
PORT=3005
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://tillercast.live

# ------------------------------------------------------------------------------
# 2. SUPER ADMIN CREDENTIALS & SECURITY
# ------------------------------------------------------------------------------
# Generate a strong password and a random 32-byte secret for signing admin session tokens.
ADMIN_USER=admin
ADMIN_PASSWORD=change_me_to_a_long_random_password
ADMIN_SECRET=generate_a_random_32_byte_hex_string_for_hmac_signing

# ------------------------------------------------------------------------------
# 3. AI SCRIPT & COPILOT LLM PROVIDERS (Optional — Intelligent fallbacks included)
# ------------------------------------------------------------------------------
# Google Gemini 3.8 / 3.6 Flash API Key
GEMINI_API_KEY=

# OpenRouter AI for Multi-LLM Script Generation
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat

# OpenAI API Key for GPT-4o Scripting (Get at: https://platform.openai.com/)
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 4. VOICE SYNTHESIS PROVIDERS (Optional — Google Neural & Windows SAPI fallbacks included)
# ------------------------------------------------------------------------------
# ElevenLabs API Key for Ultra-Realistic AI Voices (Get at: https://elevenlabs.io/)
ELEVENLABS_API_KEY=

# ------------------------------------------------------------------------------
# 5. STOCK FOOTAGE & AI IMAGE PROVIDERS (Optional — Procedural Canvas fallbacks included)
# ------------------------------------------------------------------------------
# Pexels API Key for HD Stock Video B-Roll (Get at: https://www.pexels.com/api/)


# Pixabay API Key for HD B-Roll Clips (Get at: https://pixabay.com/api/docs/)


# Cloudflare Workers AI & AI Gateway
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_AI_GATEWAY_ID=tillercast-gateway

# Cloudflare R2 Object Storage (S3 Compatible)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=tillercast-media
R2_PUBLIC_URL=https://media.yourdomain.com

# ------------------------------------------------------------------------------
# 6. GOOGLE OAUTH 2.0 (User Login / Signup & YouTube Publishing)
# ------------------------------------------------------------------------------
# Configure OAuth 2.0 Web Application credentials at: https://console.cloud.google.com/
#
# Authorized JavaScript Origins:
#   - http://localhost:3005 (or 3000)
#   - https://tillercast.live
#
# Authorized Redirect URIs to add in Google Cloud Console:
#   1. User Login Dev:  http://localhost:3005/api/auth/google/callback
#   2. User Login Prod: https://tillercast.live/api/auth/google/callback
#   3. YouTube Dev:     http://localhost:3005/api/auth/youtube/callback
#   4. YouTube Prod:    https://tillercast.live/api/auth/youtube/callback
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=https://tillercast.live/api/auth/google/callback

# Aliases also supported:
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://tillercast.live/api/auth/youtube/callback

# ------------------------------------------------------------------------------
# 7. MONETIZATION & STRIPE PAYMENTS (Optional — Built-in ledger active)
# ------------------------------------------------------------------------------
# Stripe API Keys (Get at: https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ------------------------------------------------------------------------------
# 8. STORAGE & FFMPEG
# ------------------------------------------------------------------------------
# Path to custom FFmpeg binary (Leave empty to use system PATH or bundled binary)
FFMPEG_PATH=
LOCAL_STORAGE_DIR=./storage

FAL_KEY=

# ------------------------------------------------------------------------------
# 9. SOCIAL MEDIA PUBLISHING CHANNELS (Reddit, X / Twitter, LinkedIn)
# ------------------------------------------------------------------------------
# Reddit API (Create "script" app at https://www.reddit.com/prefs/apps)
# Unlimited Free tier (100 QPM)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# X / Twitter API v2 (Get at https://developer.x.com/en/portal/dashboard)
# Free tier: 500 tweets/month ($0)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# LinkedIn REST API (Get at https://developer.linkedin.com/)
# 100% Free Developer tier
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=

# Typefully API Key (Optional secondary cross-poster: https://typefully.com/?settings=api)
TYPEFULLY_API_KEY=

